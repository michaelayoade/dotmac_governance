  "capability_roster": [
    {
      "component_id": "dotmac-campaigns",
      "disposition": "replace",
      "rationale": "Sub owns outbound campaign execution today; cutover 1 is already Sub-first in the Starter dossier. Enters a cohort when the Sub campaign writer retirement is scheduled."
    },
    {
      "component_id": "dotmac-documents",
      "disposition": "retain",
      "rationale": "Document storage is a shared enabling capability consumed through Files and Document Rendering. ISP composes it only if a cohort names a document writer it owns."
    },
    {
      "component_id": "dotmac-records",
      "disposition": "retain",
      "rationale": "Retention/records policy is an enabling capability with no ISP-owned decision in the current cohorts."
    },
    {
      "component_id": "dotmac-content",
      "disposition": "retain",
      "rationale": "Editorial content is a marketing-side capability; the Dotmac ERP product is its named first cutover, not ISP."
    },
    {
      "component_id": "dotmac-publishing",
      "disposition": "retain",
      "rationale": "Publishing targets the Dotmac ERP product as cutover 1; ISP has no publishing authority in scope."
    },
    {
      "component_id": "dotmac-sites",
      "disposition": "retain",
      "rationale": "Site builder targets the Dotmac ERP product as cutover 1; no ISP-owned site authority exists."
    },
    {
      "component_id": "dotmac-surveys",
      "disposition": "retain",
      "rationale": "Feedback evidence only (ADR-0035); no ISP subject-consequence owner is in scope, so it stays available rather than scheduled."
    },
    {
      "component_id": "dotmac-media-observations",
      "disposition": "retain",
      "rationale": "Adoption PAUSED by Michael on 2026-08-18 and not resumed; it must not enter a cohort while paused."
    },
    {
      "component_id": "dotmac-web-analytics",
      "disposition": "retain",
      "rationale": "First-party website observations; the Dotmac ERP product and Sub are the named independent adopters, not ISP."
    },
    {
      "component_id": "dotmac-procurement",
      "disposition": "retain",
      "rationale": "Procurement is an ERP-authoritative back-office domain; ISP holds opaque references rather than owning supply."
    },
    {
      "component_id": "dotmac-expenses",
      "disposition": "retain",
      "rationale": "Expenses is an ERP-authoritative back-office domain with no ISP writer in scope."
    }
  ],
  "open_decisions": [
    {
      "decision_id": "dec-isp-002",
      "question": "Assign the production deployment owner and any eventual target host for the already named independent Dotmac ISP assembly?",
      "owner": "Michael Ayoade",
      "state": "open",
      "blocks": [
        "ctl-isp-002",
        "cohort-isp-01"
      ]
    },
    {
      "decision_id": "dec-isp-003",
      "question": "Approve the enforceable legacy Sub transition rule, including its narrow exception workflow for bounded in-place module adoption that retires one local writer?",
      "owner": "Michael Ayoade",
      "state": "open",
      "blocks": [
        "ctl-isp-003"
      ]
    },
    {
      "decision_id": "dec-isp-004",
      "question": "Adjudicate the reusable analytics and reporting owner before the final cohort starts?",
      "owner": "Michael Ayoade",
      "state": "open",
      "blocks": [
        "cohort-isp-08"
      ]
    },
    {
      "decision_id": "dec-isp-005",
      "question": "Cohort 7 assigns three platform-plane modules — Support Access, Platform Health and Deployment Control — to the Dotmac ISP assembly, which declares platform_surface_enabled=False and can therefore never compose them. Treat all three as external control-plane dependencies consumed over versioned APIs, or introduce a separately governed supported platform assembly as their target?",
      "owner": "Michael Ayoade",
      "state": "open",
      "blocks": [
        "cohort-isp-07"
      ]
    },
    {
      "decision_id": "dec-isp-006",
      "question": "Inventory and Assets are adopted by ISP in cohort 3, while their Starter extraction dossiers name ERP as first cutover. Does ISP own a separate network stock and asset estate, or does it hold opaque references to ERP-owned stock and assets? Both products composing these lineages as parallel writers is refused either way.",
