{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dotmac repository engineering conformance profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "repository", "governance_model", "enforcement_mode", "authorities", "typed_contract_surfaces", "module_declared_vocabularies", "testing_kit_boundary"],
  "properties": {
    "schema_version": {"const": 4},
    "profile_id": {"$ref": "#/$defs/slug"},
    "repository": {"$ref": "#/$defs/repository"},
    "governance_model": {"$ref": "#/$defs/governance_model"},
    "enforcement_mode": {"type": "string", "enum": ["candidate", "required"]},
    "authorities": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/authority"}},
    "typed_contract_surfaces": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/surface"}},
    "module_declared_vocabularies": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/vocabulary"}},
    "testing_kit_boundary": {"$ref": "#/$defs/testing_kit_boundary"}
  },
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "paths": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
    "nonempty_paths": {"allOf": [{"$ref": "#/$defs/paths"}, {"minItems": 1}]},
    "repository": {
      "type": "object", "additionalProperties": false,
      "required": ["canonical_url", "default_branch"],
      "properties": {
        "canonical_url": {"type": "string", "pattern": "^https://[^/\\s]+/[^/\\s]+/[^/\\s]+$"},
        "default_branch": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"}
      }
    },
    "governance_model": {
      "oneOf": [
        {"$ref": "#/$defs/local_governance_model"},
        {"$ref": "#/$defs/pinned_governance_model"}
      ]
    },
    "local_governance_model": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "source", "status"],
      "properties": {
        "kind": {"const": "local"},
        "source": {"$ref": "#/$defs/path"},
        "status": {"type": "string", "enum": ["proposed", "accepted"]}
      }
    },
    "pinned_governance_model": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "canonical_url", "revision", "source", "status"],
      "properties": {
        "kind": {"const": "pinned"},
        "canonical_url": {"type": "string", "pattern": "^https://[^/\\s]+/[^/\\s]+/[^/\\s]+$"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "source": {"$ref": "#/$defs/path"},
        "status": {"type": "string", "enum": ["proposed", "accepted"]}
      }
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["authority_id", "subject", "protected_resources", "owner_component", "owner_implementation", "decision_interface", "canonical_writer_paths", "adapter_paths", "drift_test_paths"],
      "properties": {
        "authority_id": {"$ref": "#/$defs/slug"},
        "subject": {"type": "string", "minLength": 1},
        "protected_resources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}},
        "owner_component": {"$ref": "#/$defs/slug"},
        "owner_implementation": {"$ref": "#/$defs/path"},
        "decision_interface": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)+$"},
        "canonical_writer_paths": {"$ref": "#/$defs/nonempty_paths"},
        "adapter_paths": {"$ref": "#/$defs/paths"},
        "drift_test_paths": {"$ref": "#/$defs/nonempty_paths"}
      }
    },
    "vocabulary": {
      "type": "object", "additionalProperties": false,
      "required": ["vocabulary_id", "subject", "member_type", "member_type_path", "registry_interface", "registry_implementation", "declaration_field", "declaration_paths", "storage_column", "storage_paths"],
      "properties": {
        "vocabulary_id": {"$ref": "#/$defs/slug"},
        "subject": {"type": "string", "minLength": 1},
        "member_type": {"$ref": "#/$defs/identifier"},
        "member_type_path": {"$ref": "#/$defs/path"},
        "registry_interface": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)+$"},
        "registry_implementation": {"$ref": "#/$defs/path"},
        "declaration_field": {"$ref": "#/$defs/identifier"},
        "declaration_paths": {"$ref": "#/$defs/nonempty_paths"},
        "storage_column": {"$ref": "#/$defs/identifier"},
        "storage_paths": {"$ref": "#/$defs/nonempty_paths"}
      }
    },
    "surface": {
      "type": "object", "additionalProperties": false,
      "required": ["surface_id", "paths", "require_public_annotations", "forbid_any", "require_immutable_records"],
      "properties": {
        "surface_id": {"$ref": "#/$defs/slug"},
        "paths": {"$ref": "#/$defs/nonempty_paths"},
        "require_public_annotations": {"type": "boolean"},
        "forbid_any": {"type": "boolean"},
        "require_immutable_records": {"type": "boolean"}
      }
    },
    "testing_kit_boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["test_roots", "kit_source_roots", "conformance_probes"],
      "properties": {
        "test_roots": {"$ref": "#/$defs/nonempty_paths"},
        "kit_source_roots": {"$ref": "#/$defs/paths"},
        "conformance_probes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/conformance_probe"}}
      }
    },
    "conformance_probe": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "expected_import_count"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "expected_import_count": {"type": "integer", "minimum": 1}
      }
    }
  }
}
