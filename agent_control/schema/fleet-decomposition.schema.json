{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/michaelayoade/dotmac_governance/agent_control/schema/fleet-decomposition.schema.json",
  "title": "Dotmac fleet decomposition matrix",
  "description": "Six entity types with different invariants. Structural contract only; the semantic invariants a schema cannot express (computed extraction state, duplicate fact ownership, foreign-key resolution, the adjudication requirement) are enforced by tools/fleet_matrix.py and gated by tests/test_fleet_decomposition.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "as_of",
    "source_revisions",
    "modules",
    "capabilities",
    "assemblies",
    "bindings",
    "cutovers",
    "decisions"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "as_of": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "source_revisions": {
      "description": "Repository -> revision the claims below were measured at. Facts go stale; a matrix that disagrees with the code is wrong, not authoritative.",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 4 }
    },

    "modules": {
      "type": "array",
      "items": { "$ref": "#/$defs/module" }
    },
    "capabilities": {
      "type": "array",
      "items": { "$ref": "#/$defs/capability" }
    },
    "assemblies": {
      "type": "array",
      "items": { "$ref": "#/$defs/assembly" }
    },
    "bindings": {
      "type": "array",
      "items": { "$ref": "#/$defs/binding" }
    },
    "cutovers": {
      "type": "array",
      "items": { "$ref": "#/$defs/cutover" }
    },
    "decisions": {
      "type": "array",
      "items": { "$ref": "#/$defs/decision" }
    }
  },

  "$defs": {
    "module_id": {
      "description": "Immutable semantic id. THE foreign key. Display codes are never foreign keys.",
      "type": "string",
      "pattern": "^mod\\.[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "capability_id": {
      "type": "string",
      "pattern": "^cap\\.[a-z0-9]+(-[a-z0-9]+)*(\\.[a-z0-9]+(-[a-z0-9]+)*)+$"
    },
    "assembly_id": {
      "type": "string",
      "pattern": "^asm\\.[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "binding_id": {
      "type": "string",
      "pattern": "^bind\\.[a-z0-9]+(-[a-z0-9]+)*(\\.[a-z0-9]+(-[a-z0-9]+)*)+$"
    },
    "cutover_id": {
      "type": "string",
      "pattern": "^cut\\.[a-z0-9]+(-[a-z0-9]+)*(\\.[a-z0-9]+(-[a-z0-9]+)*)+$"
    },
    "decision_id": {
      "type": "string",
      "pattern": "^dec\\.[a-z0-9]+(-[a-z0-9]+)*(\\.[a-z0-9]+(-[a-z0-9]+)*)+$"
    },
    "fact_key": {
      "description": "A stable machine key for one owned fact. Prose cannot be checked for duplicate ownership; this can.",
      "type": "string",
      "pattern": "^fact\\.[a-z0-9]+(-[a-z0-9]+)*(\\.[a-z0-9]+(-[a-z0-9]+)*)+$"
    },
    "display_code": {
      "description": "Ordering/readability only. MUST NOT appear as a foreign key anywhere, including EXTRACTION.toml.",
      "type": "string",
      "pattern": "^[A-Z]?[0-9]{1,3}$|^[MIA][0-9]{1,3}$"
    },
    "evidence": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9_]+:.+$" }
    },
    "gate_state": {
      "enum": ["not-started", "in-progress", "passed", "blocked"]
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": { "$ref": "#/$defs/gate_state" },
        "evidence": { "$ref": "#/$defs/evidence" },
        "note": { "type": "string" }
      }
    },

    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "band", "owns_capabilities"],
      "properties": {
        "id": { "$ref": "#/$defs/module_id" },
        "display_code": { "$ref": "#/$defs/display_code" },
        "name": { "type": "string", "minLength": 1 },
        "kind": {
          "description": "A stateful module owns a mod_* namespace and a migration lineage (hard rule 14). A host-facility lives in the host schema and owns no lineage of its own — it cannot be both.",
          "enum": ["module", "host-facility"]
        },
        "band": {
          "enum": [
            "foundation",
            "shared-capability",
            "business",
            "engagement",
            "isp",
            "sku"
          ]
        },
        "distribution": { "type": ["string", "null"] },
        "namespace": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["db_schema", "migration_prefix", "branch_label", "allocated"],
              "properties": {
                "db_schema": { "type": "string", "pattern": "^mod_[a-z0-9]{2,8}$" },
                "migration_prefix": { "type": "string", "pattern": "^[a-z]{1,6}$" },
                "branch_label": { "type": "string", "pattern": "^[a-z0-9_]+$" },
                "allocated": {
                  "description": "true only when the row exists in the kernel's MIGRATION_OWNER_LEDGER.",
                  "type": "boolean"
                }
              }
            }
          ]
        },
        "owns_capabilities": {
          "description": "Externally, the module owns these capability CONTRACTS. Internally, named services own the individual decisions and transitions inside them.",
          "type": "array",
          "items": { "$ref": "#/$defs/capability_id" }
        },
        "source_repositories": { "type": "array", "items": { "type": "string" } },
        "evidence": { "$ref": "#/$defs/evidence" },
        "note": { "type": "string" }
      }
    },

    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "target_boundary", "current_claims"],
      "properties": {
        "id": { "$ref": "#/$defs/capability_id" },
        "display_code": { "$ref": "#/$defs/display_code" },
        "name": { "type": "string", "minLength": 1 },
        "target_boundary": {
          "enum": [
            "kernel-primitive",
            "shared-module",
            "owning-domain-module",
            "product-owned",
            "provider-adapter",
            "undecided"
          ]
        },
        "owned_facts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "statement"],
            "properties": {
              "key": { "$ref": "#/$defs/fact_key" },
              "statement": { "type": "string", "minLength": 1 },
              "transitions": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "current_claims": {
          "description": "Who asserts authority over this capability TODAY. More than one is permitted ONLY with an unresolved `adjudication` reference.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repository", "owner"],
            "properties": {
              "repository": { "type": "string" },
              "owner": { "type": "string" },
              "evidence": { "$ref": "#/$defs/evidence" }
            }
          }
        },
        "adjudication": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/decision_id" }]
        },
        "depends_on": {
          "type": "array",
          "items": { "$ref": "#/$defs/capability_id" }
        },
        "note": { "type": "string" }
      }
    },

    "assembly": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/assembly_id" },
        "name": { "type": "string", "minLength": 1 },
        "sku": { "type": "boolean" },
        "repository": { "type": ["string", "null"] },
        "note": { "type": "string" }
      }
    },

    "binding": {
      "description": "assembly x capability x local|remote. Installation is a property of THIS, never of a module: the same capability may be installed locally in one assembly and bound remotely in another.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "assembly", "capability", "installation", "state"],
      "properties": {
        "id": { "$ref": "#/$defs/binding_id" },
        "assembly": { "$ref": "#/$defs/assembly_id" },
        "capability": { "$ref": "#/$defs/capability_id" },
        "installation": {
          "description": "local = in-process module. remote = the CAPABILITY DECISION is made by another system. A third-party provider reached over the network is `transport`, not a remote binding.",
          "enum": ["local", "remote"]
        },
        "remote_authority": {
          "description": "Required when installation is remote: which system decides.",
          "type": ["string", "null"]
        },
        "transport": {
          "description": "External systems this binding talks to. Transport is never authority.",
          "type": "array",
          "items": { "type": "string" }
        },
        "state": { "enum": ["planned", "shadow", "live", "retired"] },
        "note": { "type": "string" }
      }
    },

    "cutover": {
      "description": "One source authority -> one target binding. A module may have SEVERAL source cutovers in different states; gates belong to the transition, never to the module.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "target_binding", "gates"],
      "properties": {
        "id": { "$ref": "#/$defs/cutover_id" },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "authority"],
          "properties": {
            "repository": { "type": "string" },
            "authority": { "type": "string" },
            "evidence": { "$ref": "#/$defs/evidence" }
          }
        },
        "target_binding": { "$ref": "#/$defs/binding_id" },
        "gates": {
          "description": "The four conditions of extraction. There is deliberately NO `status` field: extraction state is COMPUTED from these and must never be assigned by hand.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "authority_moved",
            "source_consuming",
            "parity_proven",
            "old_writer_retired"
          ],
          "properties": {
            "authority_moved": { "$ref": "#/$defs/gate" },
            "source_consuming": { "$ref": "#/$defs/gate" },
            "parity_proven": { "$ref": "#/$defs/gate" },
            "old_writer_retired": { "$ref": "#/$defs/gate" }
          }
        },
        "blocked_by": {
          "type": "array",
          "items": { "$ref": "#/$defs/decision_id" }
        },
        "note": { "type": "string" }
      }
    },

    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "state", "order"],
      "properties": {
        "id": { "$ref": "#/$defs/decision_id" },
        "display_code": { "$ref": "#/$defs/display_code" },
        "title": { "type": "string", "minLength": 1 },
        "state": {
          "description": "`blocked` is distinct from `open`: a blocked decision must not be worked, because another transition must finish first.",
          "enum": ["open", "resolved", "blocked", "deferred"]
        },
        "order": {
          "description": "Adjudication order. Lower is sooner. Unique across open decisions.",
          "type": "integer",
          "minimum": 1
        },
        "disposition": { "type": ["string", "null"] },
        "remaining": { "type": ["string", "null"] },
        "blocks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "blocked_by": {
          "type": "array",
          "items": { "$ref": "#/$defs/decision_id" }
        },
        "evidence": { "$ref": "#/$defs/evidence" },
        "note": { "type": "string" }
      }
    }
  }
}
