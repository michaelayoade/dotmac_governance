{
  "schema_version": 10,
  "profile_id": "dotmac-governance-engineering-standards",
  "repository": {
    "canonical_url": "https://github.com/michaelayoade/dotmac_governance",
    "default_branch": "main"
  },
  "governance_model": {
    "kind": "local",
    "source": "docs/adr/0006-cross-repository-engineering-conformance.md",
    "status": "accepted"
  },
  "enforcement_mode": "required",
  "authorities": [
    {
      "authority_id": "cross-repository-engineering-conformance",
      "subject": "Cross-repository engineering policy decisions and conformance evaluation.",
      "protected_resources": [
        "engineering-conformance-policy",
        "engineering-conformance-diagnostics",
        "repository-standards-profile",
        "external-connector-runtime-authority"
      ],
      "owner_component": "standards-control",
      "owner_implementation": "standards_control/engine.py",
      "decision_interface": "standards_control.engine.verify_repository",
      "canonical_writer_paths": [
        "standards_control/engine.py",
        "policies/external-connector-runtime-authority.json"
      ],
      "adapter_paths": [
        ".github/actions/standards-check/action.yml",
        "standards_control/cli.py",
        "standards_control/profile.py",
        "tools/dotmac-standards"
      ],
      "drift_test_paths": [
        "tests/test_standards_control.py"
      ]
    }
  ],
  "typed_contract_surfaces": [
    {
      "surface_id": "standards-control-contracts",
      "paths": [
        "standards_control/contracts.py"
      ],
      "require_public_annotations": true,
      "forbid_any": true,
      "require_immutable_records": true
    }
  ],
  "module_declared_vocabularies": [],
  "testing_kit_boundary": {
    "test_roots": [
      "tests"
    ],
    "kit_source_roots": [],
    "conformance_probes": []
  },
  "external_connector_surface": {
    "baselines": {
      "outbound_transport": 0,
      "webhook_surface": 0,
      "provider_credential": 0,
      "connector_task": 0,
      "sync_checkpoint": 0,
      "delivery_retry": 0
    },
    "conserved_exclusions": []
  },
  "deployment_artefact_surfaces": []
}
