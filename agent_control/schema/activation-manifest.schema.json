{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/michaelayoade/dotmac_governance/agent_control/schema/activation-manifest.schema.json",
  "title": "Dotmac local agent activation manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "endpoint_id",
    "policy_id",
    "policy_version",
    "source_revision",
    "target_root",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "prepared",
        "applied",
        "rolled-back"
      ]
    },
    "endpoint_id": {
      "$ref": "#/$defs/kebab_id"
    },
    "policy_id": {
      "$ref": "#/$defs/kebab_id"
    },
    "policy_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.-]+)?$"
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "target_root": {
      "type": "string",
      "pattern": "^/"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "kebab_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "nullable_non_negative_integer": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "nullable_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "target",
        "action",
        "desired_sha256",
        "backup_path",
        "prior_sha256",
        "prior_mode",
        "prior_uid",
        "prior_gid"
      ],
      "properties": {
        "kind": {
          "enum": [
            "codex-global-instructions",
            "codex-managed-config",
            "codex-requirements",
            "claude-managed-instructions",
            "claude-user-instructions",
            "claude-managed-settings",
            "claude-managed-mcp"
          ]
        },
        "target": {
          "type": "string",
          "pattern": "^/"
        },
        "action": {
          "enum": [
            "created",
            "replaced",
            "unchanged"
          ]
        },
        "desired_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "backup_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "prior_sha256": {
          "$ref": "#/$defs/nullable_sha256"
        },
        "prior_mode": {
          "$ref": "#/$defs/nullable_non_negative_integer"
        },
        "prior_uid": {
          "$ref": "#/$defs/nullable_non_negative_integer"
        },
        "prior_gid": {
          "$ref": "#/$defs/nullable_non_negative_integer"
        }
      }
    }
  }
}
