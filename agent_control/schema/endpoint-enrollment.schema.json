{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/michaelayoade/dotmac_governance/agent_control/schema/endpoint-enrollment.schema.json",
  "title": "Dotmac agent endpoint enrollment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "endpoint_id",
    "endpoint_class",
    "platform",
    "principal",
    "local_user",
    "credential_pointer",
    "credential_environment_variable",
    "user_home",
    "allowed_surfaces",
    "policy_id"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "endpoint_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "endpoint_class": {
      "enum": [
        "developer-workstation",
        "ci-runner"
      ]
    },
    "platform": {
      "enum": [
        "macos",
        "linux"
      ]
    },
    "principal": {
      "type": "string",
      "pattern": "^agent:[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "local_user": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_-]*$"
    },
    "credential_pointer": {
      "type": "string",
      "pattern": "^(openbao:secret/[A-Za-z0-9._/-]+#[A-Za-z0-9._-]+|file:/\\S+)$"
    },
    "credential_environment_variable": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "user_home": {
      "type": "string",
      "pattern": "^/"
    },
    "allowed_surfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "codex",
          "claude-code"
        ]
      }
    },
    "policy_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  }
}
