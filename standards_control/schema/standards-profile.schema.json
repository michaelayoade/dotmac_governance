{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dotmac repository engineering conformance profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "repository", "governance_model", "enforcement_mode", "authorities", "typed_contract_surfaces"],
  "properties": {
    "schema_version": {"const": 1},
    "profile_id": {"$ref": "#/$defs/slug"},
    "repository": {"$ref": "#/$defs/repository"},
    "governance_model": {"$ref": "#/$defs/governance_model"},
    "enforcement_mode": {"type": "string", "enum": ["candidate", "required"]},
    "authorities": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/authority"}},
    "typed_contract_surfaces": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/surface"}}
  },
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "paths": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
    "nonempty_paths": {"allOf": [{"$ref": "#/$defs/paths"}, {"minItems": 1}]},
    "repository": {
      "type": "object", "additionalProperties": false,
      "required": ["canonical_url", "default_branch"],
      "properties": {
        "canonical_url": {"type": "string", "pattern": "^https://[^/\\s]+/[^/\\s]+/[^/\\s]+$"},
        "default_branch": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"}
      }
    },
    "governance_model": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "status"],
      "properties": {
        "source": {"$ref": "#/$defs/path"},
        "status": {"type": "string", "enum": ["proposed", "accepted"]}
      }
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["authority_id", "subject", "protected_resources", "owner_component", "owner_implementation", "decision_interface", "canonical_writer_paths", "adapter_paths", "drift_test_paths"],
      "properties": {
        "authority_id": {"$ref": "#/$defs/slug"},
        "subject": {"type": "string", "minLength": 1},
        "protected_resources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}},
        "owner_component": {"$ref": "#/$defs/slug"},
        "owner_implementation": {"$ref": "#/$defs/path"},
        "decision_interface": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)+$"},
        "canonical_writer_paths": {"$ref": "#/$defs/nonempty_paths"},
        "adapter_paths": {"$ref": "#/$defs/paths"},
        "drift_test_paths": {"$ref": "#/$defs/nonempty_paths"}
      }
    },
    "surface": {
      "type": "object", "additionalProperties": false,
      "required": ["surface_id", "paths", "require_public_annotations", "forbid_any", "require_immutable_records"],
      "properties": {
        "surface_id": {"$ref": "#/$defs/slug"},
        "paths": {"$ref": "#/$defs/nonempty_paths"},
        "require_public_annotations": {"type": "boolean"},
        "forbid_any": {"type": "boolean"},
        "require_immutable_records": {"type": "boolean"}
      }
    }
  }
}
